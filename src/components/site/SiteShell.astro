---
import SiteNav from './SiteNav.astro';
import MobileNav from './MobileNav.astro';
import SearchDialog from './SearchDialog.astro';
import { buildSearchIndex } from '../../lib/search';

const items = await buildSearchIndex();
const path = Astro.url.pathname;
---

<SiteNav path={path} />
<MobileNav path={path} />
<slot />
<footer class="site-foot">
  <span>tontide1 — <span aria-hidden="true">©</span> {new Date().getFullYear()}</span>
  <span class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <a href="https://github.com/tontide1" target="_blank" rel="noopener noreferrer">github</a>
    <a href="https://www.linkedin.com/in/tontide1" target="_blank" rel="noopener noreferrer">linkedin</a>
    <a href="mailto:phantantaiforwork@gmail.com">mail</a>
    <a href="/rss.xml">rss</a>
  </span>
</footer>
<SearchDialog items={items} />
