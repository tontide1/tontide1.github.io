---
interface Props {
  name: string;
  stack: string[];
  index: number;
  /** A one-line glyph banner, e.g. the year. */
  corner?: string;
}

const { name, stack, index, corner } = Astro.props;
---

<div class="tile-poster" aria-hidden="true">
  <div class="flex items-start justify-between gap-4">
    <span class="tile-index">{String(index).padStart(2, '0')}</span>
    {corner && <span class="tile-index">{corner}</span>}
  </div>
  <div>
    <h2 class="tile-name">{name}</h2>
    <div class="tile-stack">
      {stack.slice(0, 4).map((tech) => <span>{tech}</span>)}
    </div>
  </div>
</div>
