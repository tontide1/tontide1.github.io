---
interface Props {
  href: string;
  date: string;
  title: string;
  summary: string;
  tags?: string[];
  /** Optional label in place of the date's leading slot, e.g. a status. */
  meta?: string;
}

const { href, date, title, summary, tags = [], meta } = Astro.props;
---

<a class="entry" href={href}>
  <span class="entry-head">
    <span class="entry-date">{date}</span>
    {meta && <span class="entry-date">{meta}</span>}
    <span class="entry-title">{title}</span>
  </span>
  <p class="entry-summary">{summary}</p>
  {tags.length > 0 && (
    <span class="entry-tags">
      {tags.map((tag) => <span>#{tag}</span>)}
    </span>
  )}
</a>
