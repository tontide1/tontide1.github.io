---
/**
 * An underlined mention whose hover card names the source, its role, its date
 * and one line on the work. The mention itself is a real link, so it works
 * without the card; the card opens on hover or keyboard focus in pure CSS.
 */
import { SOURCES } from '../../lib/sources';

interface Props {
  source: string;
}

const { source } = Astro.props;
const src = SOURCES[source];
if (!src) throw new Error(`Unknown citation source: ${source}`);
const mark = src.mark ?? src.name.charAt(0);
const hint = src.external ? 'open site' : 'open page';
---

<span class="cite-wrap" data-pond-ignore>
  <a
    class="ink-link cite"
    href={src.href}
    target={src.external ? '_blank' : undefined}
    rel={src.external ? 'noopener noreferrer' : undefined}
    aria-label={`${src.name}, ${src.role}`}
  ><slot /></a>
  <span class="cite-card" role="tooltip">
    <span class="cite-head">
      <span class="cite-mark" aria-hidden="true">{mark}</span>
      <span class="cite-name">{src.name}</span>
      <span class="cite-date">{src.dates}</span>
    </span>
    <span class="cite-role">{src.role}</span>
    <span class="cite-summary">{src.summary}</span>
    <span class="cite-hint">
      <span>{hint}</span>
      <span aria-hidden="true">{src.external ? '↗' : '→'}</span>
    </span>
  </span>
</span>
