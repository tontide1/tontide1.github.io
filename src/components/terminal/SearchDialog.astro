---
/**
 * Site-wide search: a native <dialog> plus one inline script, no framework.
 * The index ships as JSON inside the page; filtering happens client-side.
 * Any element with `data-search-open` in the page opens the dialog.
 */
import type { SearchItem } from '../../lib/search';

interface Props {
  items: SearchItem[];
}

const { items } = Astro.props;
// `<` is the only byte that could terminate the script element early.
const payload = JSON.stringify(items).replace(/</g, '\\u003c');
---

<dialog class="search-dialog" data-search-dialog aria-label="Search the site">
  <form method="dialog" class="search-bar">
    <span aria-hidden="true">&gt;</span>
    <input data-search-input type="search" placeholder="Search pages, projects, notes" autocomplete="off" />
    <button type="submit" aria-label="Close search">esc</button>
  </form>
  <div class="search-results" data-search-results>
    <p>Type to filter the whole tree: directories, projects, research, notes, thoughts, life.</p>
  </div>
</dialog>

<script type="application/json" data-search-index set:html={payload}></script>

<script is:inline>
  (() => {
    const dialog = document.querySelector('[data-search-dialog]');
    const indexEl = document.querySelector('[data-search-index]');
    const input = dialog && dialog.querySelector('[data-search-input]');
    const results = dialog && dialog.querySelector('[data-search-results]');
    if (!dialog || !indexEl || !input || !results) return;

    const items = JSON.parse(indexEl.textContent || '[]');
    const intro = results.innerHTML;

    const isTyping = (el) =>
      el instanceof HTMLElement && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable);

    const open = () => {
      if (!dialog.open) dialog.showModal();
      input.focus();
      input.select();
    };

    const render = (query) => {
      const terms = query.trim().toLowerCase().split(/\s+/).filter(Boolean);
      if (!terms.length) {
        results.innerHTML = intro;
        return;
      }
      const hits = items
        .filter((item) => {
          const hay = `${item.title} ${item.summary} ${item.domain} ${(item.tags || []).join(' ')} ${item.meta || ''}`.toLowerCase();
          return terms.every((term) => hay.includes(term));
        })
        .slice(0, 8);
      if (!hits.length) {
        const empty = document.createElement('p');
        empty.textContent = 'No matches for "' + query.trim() + '"';
        results.replaceChildren(empty);
        return;
      }
      results.replaceChildren(
        ...hits.map((item) => {
          const link = document.createElement('a');
          link.href = item.path;
          const title = document.createElement('strong');
          title.textContent = item.title;
          const meta = document.createElement('span');
          meta.textContent = [item.domain.toUpperCase(), item.meta, item.date].filter(Boolean).join(' · ');
          link.append(title, meta);
          return link;
        })
      );
    };

    input.addEventListener('input', () => render(input.value));
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      const first = results.querySelector('a');
      if (!first) return;
      event.preventDefault();
      dialog.close();
      location.assign(first.getAttribute('href'));
    });

    document.addEventListener('keydown', (event) => {
      if (isTyping(event.target)) return;
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        open();
        return;
      }
      if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey) {
        event.preventDefault();
        open();
      }
    });

    for (const trigger of document.querySelectorAll('[data-search-open]')) {
      trigger.addEventListener('click', open);
    }
  })();
</script>
