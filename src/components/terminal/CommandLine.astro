---
import { HANDLE } from '../../lib/profile';

interface Props {
  /** Working directory shown after the host, e.g. `~/projects`. */
  cwd?: string;
  /** The command this page is "the output of". Omit for a bare prompt. */
  cmd?: string;
}

const { cwd = '~', cmd } = Astro.props;
---

<p class="cmdline">
  <span class="cmd-user">{HANDLE}</span><span class="cmd-cwd">:{cwd}</span><span class="cmd-prompt">$</span>{cmd && <span class="cmd-body">{cmd}</span>}<span class="cursor" aria-hidden="true"></span>
</p>
