---
import Layout from './Layout.astro';

interface Props {
  domain: string;
  title: string;
  role?: string;
  meta?: string;
  description?: string;
}

const { domain, title, role, meta, description } = Astro.props;
---

<Layout title={`${title} — TÀI`}>
  <div class="min-h-screen bg-[#050505] text-[#e8e8e8] font-mono flex flex-col justify-between p-6 md:p-12 max-w-4xl mx-auto">
    {/* Navigation */}
    <header class="border-b border-[#262626] pb-6 mb-12 flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center space-x-2 text-xs text-[#777777] hover:text-[#6ea8fe] transition-colors border border-[#262626] px-3 py-1.5 rounded bg-[#0a0a0a]"
      >
        <span>← RETURN TO ORBIT</span>
      </a>

      <div class="flex items-center space-x-2 text-xs text-[#525252]">
        <span>DOMAIN:</span>
        <span class="text-[#e8e8e8] font-bold">{domain}</span>
        {meta && <span class="text-[#6ea8fe]">[{meta}]</span>}
      </div>
    </header>

    {/* Header Info */}
    <div class="mb-10">
      <div class="text-[11px] text-[#6ea8fe] tracking-widest uppercase mb-2">
        {role || 'CELESTIAL DOMAIN'}
      </div>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#ffffff]">
        {title}
      </h1>
      {description && (
        <p class="text-sm md:text-base text-[#a3a3a3] leading-relaxed max-w-2xl">
          {description}
        </p>
      )}
    </div>

    {/* Main Content Area */}
    <main class="flex-grow space-y-8 text-xs md:text-sm text-[#cccccc] leading-relaxed">
      <slot />
    </main>

    {/* Footer */}
    <footer class="border-t border-[#262626] pt-8 mt-16 flex flex-col sm:flex-row items-center justify-between text-xs text-[#525252]">
      <div>TÀI // PERSONAL GRAVITY SYSTEM</div>
      <div class="mt-2 sm:mt-0">
        <a href="/" class="text-[#777777] hover:text-[#6ea8fe]">
          Back to Universe
        </a>
      </div>
    </footer>
  </div>
</Layout>
