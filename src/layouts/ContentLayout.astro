---
import Layout from './Layout.astro';
import { toIsoDate } from '../lib/seo';
import { DOMAINS } from '../lib/domains';
import { buildSearchIndex } from '../lib/search';
import CommandLine from '../components/terminal/CommandLine.astro';
import SearchTrigger from '../components/terminal/SearchTrigger.astro';
import SearchDialog from '../components/terminal/SearchDialog.astro';

interface Props {
  title: string;
  /** The command this page is the output of, e.g. `cat about.md`. */
  command: string;
  /** Working directory shown in the prompt, e.g. `~/projects`. */
  cwd?: string;
  description?: string;
  /** og:type + article timestamps; content pages are dated articles. */
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
}

const {
  title,
  command,
  cwd = '~',
  description,
  type = 'article',
  image,
  imageAlt,
  publishedTime,
  modifiedTime,
  structuredData,
  robots,
} = Astro.props;

const items = await buildSearchIndex();

// Mark the active directory in the tree without letting `/projects/x` also
// match `/projects-y`.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (path: string) => currentPath === path || currentPath.startsWith(`${path}/`);
---

<Layout
  title={`${title} — TONTIDE1`}
  description={description}
  type={type}
  image={image}
  imageAlt={imageAlt}
  publishedTime={toIsoDate(publishedTime)}
  modifiedTime={toIsoDate(modifiedTime)}
  structuredData={structuredData}
  robots={robots}
>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/">TONTIDE1</a>
      <span class="flex-1"></span>
      <SearchTrigger />
      <a class="github-link" href="https://github.com/tontide1" aria-label="TONTIDE1 on GitHub">GitHub</a>
    </div>
  </header>

  <details class="mobile-nav">
    <summary>~ navigate</summary>
    <ul class="tree">
      {DOMAINS.map((domain) => (
        <li>
          <a class="tree-link" href={domain.path} aria-current={isCurrent(domain.path) ? 'page' : undefined}>
            <span>~/{domain.label}</span><span class="tree-blurb">{domain.blurb}</span>
          </a>
        </li>
      ))}
    </ul>
  </details>

  <div class="term-frame">
    <aside class="sidebar">
      <nav aria-label="Domains">
        <ul class="tree">
          {DOMAINS.map((domain) => (
            <li>
              <a class="tree-link" href={domain.path} aria-current={isCurrent(domain.path) ? 'page' : undefined}>
                <span>~/{domain.label}</span><span class="tree-blurb">{domain.blurb}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <main id="content" class="min-w-0 pb-16 pt-8 lg:pt-12">
      <CommandLine cwd={cwd} cmd={command} />
      <h1 class="mb-3 mt-6 text-[1.875rem] font-bold leading-tight">{title}</h1>
      {description && <p class="mb-8 max-w-[46rem] text-muted">{description}</p>}
      <div class:list={['term-article', !description && 'mt-8']}>
        <slot />
      </div>
    </main>
  </div>

  <footer class="mx-auto flex w-full max-w-[72rem] flex-wrap items-center justify-between gap-3 px-6 py-6 text-xs text-muted">
    <span>[/] search · [esc] close</span>
    <a href="/">cd ~</a>
  </footer>

  <SearchDialog items={items} />
</Layout>
