---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** og:type — 'article' for dated content pages, 'website' otherwise. */
  type?: 'website' | 'article';
  /** Site-relative or absolute social card path. */
  image?: string;
  imageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  /** JSON-LD nodes, serialised into a single application/ld+json block. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Overridable so an error page can opt out of indexing. */
  robots?: string;
}

const {
  title = 'TONTIDE1 — Software Developer & AI Engineer',
  description = 'Software developer and AI engineer in Ho Chi Minh City. Projects, research, notes, thoughts, and life — one quiet page at a time.',
  type = 'website',
  image = '/img/og-default.png',
  imageAlt = 'TONTIDE1 — a warm mono personal site.',
  publishedTime,
  modifiedTime,
  structuredData,
  robots = 'index, follow, max-image-preview:large',
} = Astro.props;

const siteName = 'TONTIDE1';

// Astro.site is configured, but fall back to the request URL so dev servers and
// any future config change still emit a valid absolute URL.
const siteBase = Astro.site ?? Astro.url;

// Directories are served as index.html, so normalise every path to a trailing slash.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, siteBase).href;
const ogImage = new URL(image, siteBase).href;

// `<` is the only character that can terminate the script element early.
// A single node gets `@context` injected; arrays are assumed to carry their own.
const jsonLd = structuredData
  ? JSON.stringify(
      Array.isArray(structuredData)
        ? structuredData
        : { '@context': 'https://schema.org', ...structuredData }
    ).replace(/</g, '\\u003c')
  : null;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1917" data-theme-color />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — Feed`} href={new URL('/rss.xml', siteBase).href} />

    <!-- Social metadata: important information must exist in HTML, not only in canvas -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <!-- Fonts are self-hosted: no third-party font request on any page -->
    <link rel="preload" href="/fonts/geist-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    {/*
      Theme before first paint: dark unless the visitor chose light. The toggle
      lives here so every page shares one handler and the canvas can follow it.
      A project slide also pins its direction here, before the document renders.
    */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        root.classList.toggle('dark', stored !== 'light');
        const meta = document.querySelector('[data-theme-color]');
        if (meta) meta.setAttribute('content', stored === 'light' ? '#f5f4f1' : '#1a1917');

        const applyTheme = (theme) => {
          root.classList.toggle('dark', theme === 'dark');
          try {
            localStorage.setItem('theme', theme);
          } catch {}
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#1a1917' : '#f5f4f1');
          window.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
        };
        window.__setTheme = applyTheme;

        document.addEventListener('click', (event) => {
          const themeTrigger = event.target.closest('[data-theme-toggle]');
          if (themeTrigger) applyTheme(root.classList.contains('dark') ? 'light' : 'dark');

          // A project page's back link plays the strip slide in reverse.
          if (
            event.target.closest('[data-vt-back]') &&
            !event.metaKey &&
            !event.ctrlKey &&
            !event.shiftKey &&
            !event.altKey
          ) {
            try {
              sessionStorage.setItem('vt', 'back');
            } catch {}
          }
        });

        try {
          const dir = sessionStorage.getItem('vt');
          if (dir === 'forward' || dir === 'back') {
            root.dataset.transition = dir;
            sessionStorage.removeItem('vt');
          }
        } catch {}
      })();
    </script>
  </head>
  <body class="bg-bg text-fg font-mono antialiased">
    <slot />
  </body>
</html>
