---
/**
 * List page: a one-line scene setter with the blinking cursor, then the entries
 * as hairline-divided rows. The heading stays in the document for structure but
 * the visible header is the quote, the way the home page speaks.
 */
import SiteShell from '../components/site/SiteShell.astro';
import Layout from './Layout.astro';

interface Props {
  /** Real page title; rendered as a screen-reader heading unless `titleVisible`. */
  title: string;
  description: string;
  /** The visible one-liner, lowercase, ending in the cursor. */
  quote: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  image?: string;
  imageAlt?: string;
  robots?: string;
}

const { title, description, quote, type = 'website', structuredData, image, imageAlt, robots } = Astro.props;
---

<Layout title={`${title} — TONTIDE1`} description={description} type={type} structuredData={structuredData} image={image} imageAlt={imageAlt} robots={robots}>
  <SiteShell>
    <main class="page">
      <div class="page-narrow">
        <h1 class="sr-only">{title}</h1>
        <p class="quote" data-pond-avoid>{quote}<span class="cursor" aria-hidden="true"></span></p>
        <p class="page-lede mt-6 max-w-[32rem]">{description}</p>
        <div class="mt-12">
          <slot />
        </div>
      </div>
    </main>
  </SiteShell>
</Layout>
