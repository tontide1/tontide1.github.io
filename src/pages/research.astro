---
import { getCollection } from 'astro:content';
import ListLayout from '../layouts/ListLayout.astro';
import EntryRow from '../components/site/EntryRow.astro';
import { collectionPage } from '../lib/seo';

const researches = (await getCollection('research', ({ data }) => !data.draft)).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);

const title = 'Research Investigations';
const description =
  'What Tài investigates: structured questions, empirical hypotheses, benchmarks, and experimental pipelines.';
---

<ListLayout
  title={title}
  description={description}
  quote="questions with benchmarks."
  structuredData={collectionPage({
    title,
    description,
    url: Astro.url.href,
    section: 'Research',
    items: researches.map((r) => ({ name: r.data.title, url: new URL(`/research/${r.id}/`, Astro.url).href })),
  })}
>
  <div class="entries">
    {researches.map((item) => (
      <EntryRow
        href={`/research/${item.id}`}
        date={item.data.date}
        meta={item.data.status}
        title={item.data.title}
        summary={item.data.summary}
        tags={item.data.tags}
      />
    ))}
  </div>
</ListLayout>
