---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import { collectionPage } from '../lib/seo';

const projects = await getCollection('projects', ({ data }) => !data.draft);

const title = 'Engineered Systems & Projects';
const description =
  'What Tài builds: concrete systems, production backends, research prototypes, and open-source infrastructure.';
---

<ContentLayout
  title={title}
  command="ls"
  cwd="~/projects"
  type="website"
  description={description}
  structuredData={collectionPage({
    title,
    description,
    url: Astro.url.href,
    section: 'Projects',
    items: projects.map((p) => ({ name: p.data.title, url: new URL(`/projects/${p.id}/`, Astro.url).href })),
  })}
>
  <div class="space-y-4">
    {projects.map((proj) => (
      <article class="card">
        <div class="card-eyebrow">
          <span class="text-amber">{proj.data.status}</span>
          <span>{proj.data.date}</span>
        </div>
        <h2 class="mb-1 mt-0 text-base font-bold leading-snug">
          <a href={`/projects/${proj.id}`}>{proj.data.title}</a>
        </h2>
        <p class="mt-0 text-sm text-muted">{proj.data.summary}</p>
        <div class="tags">
          {proj.data.stack.map((tech) => <span>{tech}</span>)}
        </div>
        <div class="mt-3 flex items-center justify-between border-t border-line pt-3 text-xs">
          <a href={`/projects/${proj.id}`}>read spec →</a>
          {proj.data.github && (
            <a href={proj.data.github} target="_blank" rel="noopener noreferrer" class="text-muted">github ↗</a>
          )}
        </div>
      </article>
    ))}
  </div>
</ContentLayout>
