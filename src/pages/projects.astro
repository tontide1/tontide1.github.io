---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import { collectionPage } from '../lib/seo';

const projects = await getCollection('projects');

const title = 'Engineered Systems & Projects';
const description =
  'What Tài builds: concrete systems, production backends, research prototypes, and open-source infrastructure.';
---

<ContentLayout
  domain="PROJECTS"
  title={title}
  role="Structured Celestial Body"
  type="website"
  meta="SYSTEMS / ARTIFACTS"
  description={description}
  structuredData={collectionPage({
    title,
    description,
    url: Astro.url.href,
    section: 'Projects',
    items: projects.map((p) => ({ name: p.data.title, url: new URL(`/projects/${p.id}/`, Astro.url).href })),
  })}
>
  <div class="space-y-6">
    {projects.map((proj) => (
      <article class="bg-[#0a0a0a] border border-[#1f1f1f] hover:border-[#3a3a3a] transition-colors p-6 rounded">
        <div class="flex items-center justify-between mb-3">
          <a href={`/projects/${proj.id}`} class="text-lg font-bold text-[#ffffff] hover:text-[#6ea8fe] tracking-wide transition-colors">
            {proj.data.title} →
          </a>
          <span class="text-[10px] px-2 py-0.5 rounded border border-[#262626] text-[#6ea8fe] bg-[#111111]">
            {proj.data.status.toUpperCase()}
          </span>
        </div>

        <p class="text-[#a3a3a3] text-xs md:text-sm mb-4 leading-relaxed">
          {proj.data.summary}
        </p>

        <div class="flex flex-wrap items-center gap-2 mb-4">
          {proj.data.stack.map((tech) => (
            <span class="text-[10px] text-[#777777] bg-[#141414] px-2 py-0.5 rounded">
              {tech}
            </span>
          ))}
        </div>

        <div class="text-xs pt-3 border-t border-[#1a1a1a] flex items-center justify-between">
          <a
            href={`/projects/${proj.id}`}
            class="text-[#e8e8e8] hover:text-[#6ea8fe] underline font-semibold"
          >
            Read Technical Spec →
          </a>
          {proj.data.github && (
            <a
              href={proj.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#777777] hover:text-[#e8e8e8]"
            >
              GitHub ↗
            </a>
          )}
        </div>
      </article>
    ))}
  </div>
</ContentLayout>
