---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/site/SiteNav.astro';
import MobileNav from '../components/site/MobileNav.astro';
import SearchDialog from '../components/site/SearchDialog.astro';
import ProjectCover from '../components/site/ProjectCover.astro';
import { buildSearchIndex } from '../lib/search';
import { collectionPage } from '../lib/seo';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
const items = await buildSearchIndex();
const path = Astro.url.pathname;

const title = 'Engineered Systems & Projects';
const description =
  'What Tài builds: concrete systems, production backends, research prototypes, and open-source infrastructure.';
---

<Layout
  title={`${title} — TONTIDE1`}
  description={description}
  structuredData={collectionPage({
    title,
    description,
    url: Astro.url.href,
    section: 'Projects',
    items: projects.map((p) => ({ name: p.data.title, url: new URL(`/projects/${p.id}/`, Astro.url).href })),
  })}
>
  <div class="projects-page">
    <h1 class="sr-only">{title}</h1>
    <MobileNav path={path} />
    <SiteNav path={path} />

    <main class="strip-main">
      <div class="strip" data-strip>
        {projects.map((project, i) => (
          <a
            class="tile"
            href={`/projects/${project.id}`}
            data-project-link
            aria-label={project.data.title}
          >
            <div class="tile-cover">
              <ProjectCover
                name={project.data.title}
                stack={project.data.stack}
                index={i + 1}
                corner={project.data.date.slice(0, 4)}
              />
              <span class="tile-hint">view project</span>
            </div>
            <span class="tile-meta">
              <span class="tile-meta-name">{project.data.title}</span>
              <span class="tile-meta-year">{project.data.date.slice(0, 4)}</span>
            </span>
            <p class="tile-tagline">{project.data.summary}</p>
          </a>
        ))}
      </div>
    </main>

    <div class="projects-mobile">
      <div class="projects-mobile-inner">
        {projects.map((project, i) => (
          <article>
            <a href={`/projects/${project.id}`} data-project-link aria-label={project.data.title}>
              <div class="tile-cover">
                <ProjectCover
                  name={project.data.title}
                  stack={project.data.stack}
                  index={i + 1}
                  corner={project.data.date.slice(0, 4)}
                />
              </div>
            </a>
            <h2 class="mobile-project-name">{project.data.title}</h2>
            <p class="mobile-project-desc">{project.data.summary}</p>
            <div class="mobile-project-year">
              <span>Year</span>
              {project.data.date.slice(0, 4)}
            </div>
            <a class="pill-button" href={`/projects/${project.id}`} data-project-link>View project</a>
          </article>
        ))}
      </div>
    </div>
  </div>

  <SearchDialog items={items} />
</Layout>

<script is:inline>
  // Desktop: the strip is a sideways page. A vertical wheel turns into a
  // horizontal glide with momentum; keys, touch and trackpads scroll it too.
  (() => {
    const strip = document.querySelector('[data-strip]');
    if (!strip) return;

    const GLIDE = 0.18;
    const DESKTOP_QUERY = '(min-width: 1024px)';
    const KEY_STEPS = {
      ArrowRight: 0.1,
      ArrowDown: 0.1,
      ArrowLeft: -0.1,
      ArrowUp: -0.1,
      PageDown: 0.8,
      PageUp: -0.8,
      ' ': 0.8,
      Home: -Infinity,
      End: Infinity,
    };

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = matchMedia(DESKTOP_QUERY);
    let target = strip.scrollLeft;
    let raf = 0;

    const glide = () => {
      const before = strip.scrollLeft;
      strip.scrollLeft += (target - before) * GLIDE;
      if (strip.scrollLeft === before) {
        strip.scrollLeft = target;
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(glide);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };
    const glideBy = (delta) => {
      const max = strip.scrollWidth - strip.clientWidth;
      target = Math.max(0, Math.min(max, (raf ? target : strip.scrollLeft) + delta));
      if (still) strip.scrollLeft = target;
      else if (!raf) raf = requestAnimationFrame(glide);
    };

    window.addEventListener(
      'wheel',
      (event) => {
        if (!desktop.matches) return;
        const sideways = Math.abs(event.deltaX) > Math.abs(event.deltaY);
        if (sideways && strip.contains(event.target)) {
          stop();
          return;
        }
        event.preventDefault();
        const delta = sideways ? event.deltaX : event.deltaY;
        glideBy(event.deltaMode === 1 ? delta * 16 : delta);
      },
      { passive: false }
    );

    let touch = null;
    let vertical;
    window.addEventListener('touchstart', (event) => {
      stop();
      touch = null;
      vertical = undefined;
      if (!desktop.matches || event.touches.length !== 1) return;
      const { clientX: x, clientY: y } = event.touches[0];
      touch = { x, y, left: strip.scrollLeft, lastY: y, time: event.timeStamp, speed: 0 };
    }, { passive: true });
    window.addEventListener('touchmove', (event) => {
      if (!touch) return;
      const { clientX: x, clientY: y } = event.touches[0];
      if (vertical === undefined) {
        if (Math.hypot(x - touch.x, y - touch.y) < 6) return;
        vertical = Math.abs(y - touch.y) > Math.abs(x - touch.x);
      }
      if (!vertical) return;
      event.preventDefault();
      strip.scrollLeft = touch.left + touch.y - y;
      const dt = event.timeStamp - touch.time;
      if (dt > 0) touch.speed = (touch.lastY - y) / dt;
      touch.lastY = y;
      touch.time = event.timeStamp;
    }, { passive: false });
    const endTouch = (event) => {
      if (touch && vertical && !still && event.timeStamp - touch.time < 100) {
        glideBy(touch.speed * (1000 / 60 / GLIDE));
      }
      touch = null;
    };
    window.addEventListener('touchend', endTouch);
    window.addEventListener('touchcancel', endTouch);

    window.addEventListener('keydown', (event) => {
      const step = KEY_STEPS[event.key];
      if (!desktop.matches || step === undefined || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) {
        return;
      }
      if (event.key === ' ' && event.target instanceof HTMLButtonElement) return;
      event.preventDefault();
      glideBy((event.key === ' ' && event.shiftKey ? -step : step) * strip.clientWidth);
    });
  })();

  // The strip drifts left while the project page slides in from the right.
  document.addEventListener('click', (event) => {
    const link = event.target.closest('[data-project-link]');
    if (!link) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
    try {
      sessionStorage.setItem('vt', 'forward');
    } catch {}
  });
</script>
