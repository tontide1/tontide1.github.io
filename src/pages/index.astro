---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/site/SiteNav.astro';
import MobileNav from '../components/site/MobileNav.astro';
import SearchDialog from '../components/site/SearchDialog.astro';
import Cited from '../components/site/Cited.astro';
import Pond from '../components/pond/Pond.astro';
import { buildSearchIndex } from '../lib/search';
import { WEBSITE } from '../lib/seo';

const items = await buildSearchIndex();
const path = Astro.url.pathname;
---

<Layout
  title="TONTIDE1 — Software Developer & AI Engineer"
  description="Tai Phan — a software developer and AI engineer in Ho Chi Minh City. Retrieval systems, backend services, and a pond that never quite holds still."
  structuredData={WEBSITE}
>
  <div class="home">
    <Pond />
    <MobileNav path={path} />
    <SiteNav path={path} />

    <main class="home-main">
      <header class="home-head">
        <blockquote class="quote" data-pond-avoid>
          in a quiet pond,<br />cast a fine net.<span class="cursor" aria-hidden="true"></span>
        </blockquote>

        <div class="intro cited-text" data-pond-avoid>
          <h1>Xin chào, I&apos;m Tài.</h1>
          <p>
            Software Developer &amp; AI Engineer in Ho Chi Minh City, focused on retrieval systems and LLM applications.
          </p>
          <p>
            Currently building <Cited source="legal-rag">Legal-RAG</Cited> for Vietnamese legal question answering and exploring <Cited source="hybrid-retrieval">hybrid retrieval</Cited>.
          </p>
          <p class="socials">
            <span><a class="quiet-link" href="https://github.com/tontide1" target="_blank" rel="noopener noreferrer">github</a></span><span><span class="socials-sep"> / </span><a class="quiet-link" href="https://www.linkedin.com/in/tontide1" target="_blank" rel="noopener noreferrer">linkedin</a></span><span><span class="socials-sep"> / </span><a class="quiet-link" href="mailto:phantantaiforwork@gmail.com">mail</a></span>
          </p>
        </div>
      </header>
    </main>
  </div>

  <SearchDialog items={items} />
</Layout>
