---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

export async function getStaticPaths() {
  const items = await getCollection('thoughts');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<ContentLayout
  domain="THOUGHTS"
  title={item.data.title}
  role="Reflective Essay"
  meta="PERSPECTIVES"
  description={item.data.summary}
>
  <div class="flex items-center space-x-3 text-xs text-[#525252] mb-6">
    <span>PUBLISHED:</span>
    <span class="text-[#e8e8e8]">{item.data.date}</span>
  </div>

  <article class="prose prose-invert max-w-none space-y-4 text-xs md:text-sm text-[#cccccc] leading-relaxed border-t border-[#1f1f1f] pt-6">
    <Content />
  </article>

  {item.data.related && item.data.related.length > 0 && (
    <div class="mt-12 pt-6 border-t border-[#262626]">
      <h3 class="text-xs font-bold text-[#777777] uppercase tracking-wider mb-3">
        Gravitationally Related Artifacts
      </h3>
      <ul class="space-y-1.5 text-xs">
        {item.data.related.map((rel) => (
          <li>
            <a href={rel} class="text-[#6ea8fe] hover:underline">
              • {rel}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</ContentLayout>
