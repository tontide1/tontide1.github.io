---
import { getCollection, render } from 'astro:content';
import ProseLayout from '../../layouts/ProseLayout.astro';
import { article } from '../../lib/seo';

export async function getStaticPaths() {
  const items = await getCollection('thoughts', ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const data = item.data;
---

<ProseLayout
  title={data.title}
  backHref="/thoughts"
  backLabel="thoughts"
  description={data.summary}
  publishedTime={data.date}
  modifiedTime={data.updated ?? data.date}
  structuredData={article({
    title: data.title,
    description: data.summary,
    url: Astro.url.href,
    section: 'Thoughts',
    tags: data.tags,
    date: data.date,
    updated: data.updated,
  })}
>
  <Fragment slot="meta">
    <span>{data.date}</span>
    {data.tags.map((tag) => <span>#{tag}</span>)}
  </Fragment>

  <Content components={{ h1: 'h2' }} />

  {data.related.length > 0 && (
    <div class="mt-16 border-t border-line pt-6">
      <p class="mb-3 mt-0 text-[12px] text-muted">related</p>
      <ul class="m-0 list-none space-y-1 pl-0 text-[14px]">
        {data.related.map((rel) => (
          <li><a class="ink-link" href={rel}>{rel}</a></li>
        ))}
      </ul>
    </div>
  )}
</ProseLayout>
