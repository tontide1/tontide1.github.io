---
import { getCollection } from 'astro:content';
import ListLayout from '../layouts/ListLayout.astro';
import EntryRow from '../components/site/EntryRow.astro';
import { collectionPage } from '../lib/seo';

const essays = (await getCollection('thoughts', ({ data }) => !data.draft)).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);

const title = 'Long-Form Thoughts';
const description = 'What Tài thinks: reflections, software engineering perspectives, opinions, and personal essays.';
---

<ListLayout
  title={title}
  description={description}
  quote="thinking in public."
  structuredData={collectionPage({
    title,
    description,
    url: Astro.url.href,
    section: 'Thoughts',
    items: essays.map((e) => ({ name: e.data.title, url: new URL(`/thoughts/${e.id}/`, Astro.url).href })),
  })}
>
  <div class="entries">
    {essays.map((post) => (
      <EntryRow
        href={`/thoughts/${post.id}`}
        date={post.data.date}
        title={post.data.title}
        summary={post.data.summary}
        tags={post.data.tags}
      />
    ))}
  </div>
</ListLayout>
