---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';

const essays = await getCollection('thoughts');
---

<ContentLayout
  domain="THOUGHTS"
  title="Constellation of Ideas"
  role="Connected Constellation"
  meta="ESSAYS / PERSPECTIVES"
  description="What Tài thinks: reflections, software engineering perspectives, opinions, and personal essays."
>
  <div class="space-y-6">
    {essays.map((post) => (
      <article class="bg-[#0a0a0a] border border-[#1f1f1f] p-5 rounded hover:border-[#3a3a3a] transition-colors">
        <div class="flex items-center justify-between text-[11px] text-[#525252] mb-2">
          <span>ESSAY</span>
          <span>{post.data.date}</span>
        </div>
        <h2 class="text-base font-bold text-[#ffffff] mb-2">
          <a href={`/thoughts/${post.id}`} class="hover:text-[#e9d5ff] transition-colors">
            {post.data.title} →
          </a>
        </h2>
        <p class="text-xs text-[#a3a3a3] leading-relaxed mb-3">
          {post.data.summary}
        </p>
        <div class="pt-2 border-t border-[#1a1a1a] text-xs">
          <a href={`/thoughts/${post.id}`} class="text-[#e9d5ff] hover:underline">
            Read Full Essay →
          </a>
        </div>
      </article>
    ))}
  </div>
</ContentLayout>
