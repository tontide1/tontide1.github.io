---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import { collectionPage } from '../lib/seo';

const essays = await getCollection('thoughts', ({ data }) => !data.draft);

const title = 'Long-Form Thoughts';
const description =
  'What Tài thinks: reflections, software engineering perspectives, opinions, and personal essays.';
---

<ContentLayout
  title={title}
  command="ls"
  cwd="~/thoughts"
  type="website"
  description={description}
  structuredData={collectionPage({
    title,
    description,
    url: Astro.url.href,
    section: 'Thoughts',
    items: essays.map((e) => ({ name: e.data.title, url: new URL(`/thoughts/${e.id}/`, Astro.url).href })),
  })}
>
  <div class="space-y-4">
    {essays.map((post) => (
      <article class="card">
        <div class="card-eyebrow">
          <span class="text-amber">Essay</span>
          <span>{post.data.date}</span>
        </div>
        <h2 class="mb-1 mt-0 text-base font-bold leading-snug">
          <a href={`/thoughts/${post.id}`}>{post.data.title}</a>
        </h2>
        <p class="mt-0 text-sm text-muted">{post.data.summary}</p>
        <div class="tags">
          {post.data.tags.map((tag) => <span>#{tag}</span>)}
        </div>
      </article>
    ))}
  </div>
</ContentLayout>
