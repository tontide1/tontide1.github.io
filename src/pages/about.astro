---
import ContentLayout from '../layouts/ContentLayout.astro';
import { PERSON } from '../lib/seo';
---

<ContentLayout
  domain="TÀI"
  title="About Tai Phan"
  role="Central Gravitational Anchor"
  meta="IDENTITY / BIO"
  type="website"
  description="Software developer & AI engineer based in Ho Chi Minh City, Vietnam. Specializing in RAG architectures, high-performance backend systems, and agentic workflows."
  structuredData={PERSON}
>
  <section class="space-y-4">
    <h2 class="text-lg font-semibold text-[#ffffff] border-b border-[#262626] pb-2">
      Identity & Background
    </h2>
    <p>
      I focus on building reliable computational systems. My work spans AI application architecture (specifically RAG pipelines and legal document intelligence) and distributed backend services.
    </p>
    <p>
      This website is modeled as a <strong>Personal Gravity System</strong>: my public work, projects, research hypotheses, and thoughts orbit this central anchor.
    </p>
  </section>

  <section class="space-y-4">
    <h2 class="text-lg font-semibold text-[#ffffff] border-b border-[#262626] pb-2">
      Core Skills & Stack
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-[#0a0a0a] p-4 rounded border border-[#1f1f1f]">
        <h3 class="text-[#6ea8fe] font-bold mb-2">AI / Machine Learning</h3>
        <ul class="space-y-1 text-[#a3a3a3]">
          <li>• Retrieval-Augmented Generation (RAG)</li>
          <li>• Hybrid Retrieval (Dense + BM25)</li>
          <li>• Agentic Workflows & Multi-Agent Systems</li>
          <li>• LLM Evaluation & Benchmarking</li>
        </ul>
      </div>

      <div class="bg-[#0a0a0a] p-4 rounded border border-[#1f1f1f]">
        <h3 class="text-[#6ea8fe] font-bold mb-2">Backend & Infrastructure</h3>
        <ul class="space-y-1 text-[#a3a3a3]">
          <li>• Go / Python / TypeScript</li>
          <li>• PostgreSQL / pgvector / Redis</li>
          <li>• Linux systems & container orchestration</li>
          <li>• High-concurrency system design</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-lg font-semibold text-[#ffffff] border-b border-[#262626] pb-2">
      Contact & Links
    </h2>
    <ul class="space-y-2">
      <li>
        <span class="text-[#525252]">GitHub:</span>{' '}
        <a href="https://github.com/tontide1" target="_blank" rel="noopener noreferrer" class="text-[#6ea8fe] hover:underline">
          github.com/tontide1
        </a>
      </li>
      <li>
        <span class="text-[#525252]">Repository:</span>{' '}
        <a href="https://github.com/tontide1/tontide1.github.io" target="_blank" rel="noopener noreferrer" class="text-[#6ea8fe] hover:underline">
          tontide1.github.io
        </a>
      </li>
    </ul>
  </section>
</ContentLayout>
