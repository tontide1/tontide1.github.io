---
import ContentLayout from '../layouts/ContentLayout.astro';
import { PERSON } from '../lib/seo';

const skills = [
  {
    title: 'AI / Machine Learning',
    items: [
      'Retrieval-Augmented Generation (RAG)',
      'Hybrid Retrieval (Dense + BM25)',
      'Agentic Workflows & Multi-Agent Systems',
      'LLM Evaluation & Benchmarking',
    ],
  },
  {
    title: 'Backend & Infrastructure',
    items: [
      'High-concurrency system design',
      'Linux systems & container orchestration',
      'PostgreSQL / pgvector / Redis',
      'Python / C / TypeScript',
    ],
  },
];

const links = [
  { label: 'GitHub', value: 'github.com/tontide1', href: 'https://github.com/tontide1' },
  { label: 'Email', value: 'phantantaiforwork@gmail.com', href: 'mailto:phantantaiforwork@gmail.com' },
  { label: 'LinkedIn', value: 'in/tontide1', href: 'https://www.linkedin.com/in/tontide1' },
  { label: 'Repository', value: 'tontide1.github.io', href: 'https://github.com/tontide1/tontide1.github.io' },
];
---

<ContentLayout
  title="About Tai Phan"
  command="cat about.md"
  type="website"
  description="Software developer & AI engineer based in Ho Chi Minh City, Vietnam. Specializing in RAG architectures, high-performance backend systems, and agentic workflows."
  structuredData={PERSON}
>
  <section>
    <h2>Identity & Background</h2>
    <p>
      I focus on building reliable computational systems. My work spans AI application architecture —
      specifically RAG pipelines and legal document intelligence — and distributed backend services.
    </p>
    <p>
      This site is a terminal session you can read: the same content is served as plain HTML, one
      command per page.
    </p>
  </section>

  <section>
    <h2>Core Skills & Stack</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {skills.map((skill) => (
        <div class="border border-line p-4">
          <h3 class="mb-2 text-amber">{skill.title}</h3>
          <ul class="m-0 list-none space-y-1 pl-0 text-sm">
            {skill.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Contact & Links</h2>
    <ul class="m-0 list-none space-y-1 pl-0">
      {links.map((link) => (
        <li>
          <span class="text-muted">{link.label}:</span>{' '}
          <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            {link.value}
          </a>
        </li>
      ))}
    </ul>
  </section>
</ContentLayout>
