---
import ContentLayout from '../layouts/ContentLayout.astro';
import { DOMAINS } from '../lib/domains';

{/*
  GitHub Pages serves this for any unmatched path, so it has to be useful
  rather than decorative: the two things a lost visitor needs are a way back
  home and a way into the six directories. It is `noindex` — a dead URL should
  not be offered to a crawler as a destination.
*/}
---

<ContentLayout
  title="404 — Not Found"
  command="cat /not-found"
  type="website"
  robots="noindex, follow"
  description="The requested address does not resolve to a file in this tree. Return home, or jump straight to a directory."
>
  <p class="m-0 border border-line p-4 text-red">cat: /not-found: No such file or directory</p>

  <p>
    The address you followed does not resolve to anything in this tree. Nothing was lost — the
    path was simply never written.
  </p>

  <ul class="tree m-0 pl-0">
    {DOMAINS.map((domain) => (
      <li>
        <a class="tree-link" href={domain.path}>
          <span>~/{domain.label}</span><span class="tree-blurb">{domain.blurb}</span>
        </a>
      </li>
    ))}
  </ul>

  <p>
    If you reached this from a link on this site, it is a broken edge and worth
    <a href="https://github.com/tontide1/tontide1.github.io/issues">reporting</a>.
  </p>
</ContentLayout>
