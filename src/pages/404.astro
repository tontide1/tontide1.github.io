---
import ListLayout from '../layouts/ListLayout.astro';
import { NAV } from '../lib/domains';

{/*
  GitHub Pages serves this for any unmatched path, so it has to be useful
  rather than decorative: a way back home and a way into every directory.
  It is `noindex` — a dead URL should not be offered to a crawler.
*/}
---

<ListLayout
  title="404 — Not Found"
  description="The requested address does not resolve to a page on this site. Take a road back home, or pick a directory."
  quote="this road goes nowhere."
  robots="noindex, follow"
>
  <div class="entries">
    {NAV.map((item) => (
      <a class="entry" href={item.path}>
        <span class="entry-head">
          <span class="entry-date">../</span>
          <span class="entry-title">{item.label}</span>
        </span>
        <p class="entry-summary">{item.blurb}</p>
      </a>
    ))}
  </div>
  <p class="mt-10 text-[14px] text-muted">
    If you reached this from a link on this site, it is a broken edge and worth
    <a class="ink-link" href="https://github.com/tontide1/tontide1.github.io/issues">reporting</a>.
  </p>
</ListLayout>
