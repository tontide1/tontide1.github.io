---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { article } from '../../lib/seo';

export async function getStaticPaths() {
  const items = await getCollection('life', ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<ContentLayout
  domain="LIFE"
  title={item.data.title}
  role="Personal Milestone"
  meta="TIMELINE"
  description={item.data.summary}
  publishedTime={item.data.date}
  modifiedTime={item.data.updated ?? item.data.date}
  structuredData={article({
    title: item.data.title,
    description: item.data.summary,
    url: Astro.url.href,
    section: 'Life',
    tags: item.data.tags,
    date: item.data.date,
    updated: item.data.updated,
  })}
>
  <div class="flex items-center space-x-3 text-xs text-[#525252] mb-6">
    <span>RECORDED:</span>
    <span class="text-[#e8e8e8]">{item.data.date}</span>
  </div>

  <article class="space-y-4 text-xs md:text-sm text-[#cccccc] leading-relaxed border-t border-[#1f1f1f] pt-6">
    <Content />
  </article>
</ContentLayout>
