---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<ContentLayout
  domain="PROJECTS"
  title={project.data.title}
  role="Structured System"
  meta={project.data.status.toUpperCase()}
  description={project.data.summary}
>
  <div class="mb-6 flex flex-wrap gap-2 items-center text-xs">
    <span class="text-[#525252]">STACK:</span>
    {project.data.stack.map((item) => (
      <span class="bg-[#141414] border border-[#262626] px-2 py-0.5 rounded text-[#e8e8e8]">
        {item}
      </span>
    ))}
    {project.data.github && (
      <a
        href={project.data.github}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-auto text-[#6ea8fe] hover:underline flex items-center space-x-1"
      >
        <span>GitHub Repository ↗</span>
      </a>
    )}
  </div>

  <article class="prose prose-invert max-w-none space-y-4 text-xs md:text-sm text-[#cccccc] leading-relaxed border-t border-[#1f1f1f] pt-6">
    <Content />
  </article>

  {project.data.related && project.data.related.length > 0 && (
    <div class="mt-12 pt-6 border-t border-[#262626]">
      <h3 class="text-xs font-bold text-[#777777] uppercase tracking-wider mb-3">
        Gravitationally Related Artifacts
      </h3>
      <ul class="space-y-1.5 text-xs">
        {project.data.related.map((rel) => (
          <li>
            <a href={rel} class="text-[#6ea8fe] hover:underline">
              • {rel}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</ContentLayout>
