---
import { getCollection, render } from 'astro:content';
import ProseLayout from '../../layouts/ProseLayout.astro';
import { article } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const data = project.data;
---

<ProseLayout
  title={data.title}
  backHref="/projects"
  backLabel="projects"
  description={data.summary}
  publishedTime={data.date}
  modifiedTime={data.updated ?? data.date}
  structuredData={article({
    title: data.title,
    description: data.summary,
    url: Astro.url.href,
    section: 'Projects',
    tags: data.tags,
    date: data.date,
    updated: data.updated,
  })}
>
  <Fragment slot="meta">
    <span>{data.date}</span>
    <span>{data.status}</span>
    {data.stack.map((tech) => <span>{tech}</span>)}
    {data.github && (
      <a class="ink-link" href={data.github} target="_blank" rel="noopener noreferrer">github ↗</a>
    )}
  </Fragment>

  <Content components={{ h1: 'h2' }} />

  {data.related.length > 0 && (
    <div class="mt-16 border-t border-line pt-6">
      <p class="mb-3 mt-0 text-[12px] text-muted">related</p>
      <ul class="m-0 list-none space-y-1 pl-0 text-[14px]">
        {data.related.map((rel) => (
          <li><a class="ink-link" href={rel}>{rel}</a></li>
        ))}
      </ul>
    </div>
  )}
</ProseLayout>
