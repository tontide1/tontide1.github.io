---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import { collectionPage } from '../lib/seo';

const entries = await getCollection('life', ({ data }) => !data.draft);

const title = 'Public Timeline & Milestones';
const description =
  'Public personal experiences, technical journey, workspaces, and milestones.';
---

<ContentLayout
  domain="LIFE"
  title={title}
  role="Organic Celestial Body"
  type="website"
  meta="TIMELINE / ARCHIVE"
  description={description}
  structuredData={collectionPage({
    title,
    description,
    url: Astro.url.href,
    section: 'Life',
    items: entries.map((e) => ({ name: e.data.title, url: new URL(`/life/${e.id}/`, Astro.url).href })),
  })}
>
  <div class="relative border-l border-[#262626] ml-3 pl-6 space-y-8">
    {entries.map((item) => (
      <div class="relative">
        <div class="absolute -left-[31px] top-1 w-2.5 h-2.5 rounded-full bg-[#a7f3d0] border-2 border-[#050505]" />
        <span class="text-[10px] text-[#a7f3d0] font-bold block mb-1">
          {item.data.date}
        </span>
        <h3 class="text-sm md:text-base font-semibold text-[#ffffff] mb-1">
          <a href={`/life/${item.id}`} class="hover:text-[#a7f3d0] transition-colors">
            {item.data.title} →
          </a>
        </h3>
        <p class="text-xs text-[#a3a3a3] leading-relaxed mb-2">
          {item.data.summary}
        </p>
        <a href={`/life/${item.id}`} class="text-[11px] text-[#a7f3d0] hover:underline">
          Read Log Entry →
        </a>
      </div>
    ))}
  </div>
</ContentLayout>
