---
import { getCollection } from 'astro:content';
import ListLayout from '../layouts/ListLayout.astro';
import EntryRow from '../components/site/EntryRow.astro';
import { collectionPage } from '../lib/seo';

const entries = (await getCollection('life', ({ data }) => !data.draft)).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);

const title = 'Public Timeline & Milestones';
const description = 'Public personal experiences, technical journey, workspaces, and milestones.';
---

<ListLayout
  title={title}
  description={description}
  quote="a timeline, still being written."
  structuredData={collectionPage({
    title,
    description,
    url: Astro.url.href,
    section: 'Life',
    items: entries.map((e) => ({ name: e.data.title, url: new URL(`/life/${e.id}/`, Astro.url).href })),
  })}
>
  <div class="entries">
    {entries.map((item) => (
      <EntryRow
        href={`/life/${item.id}`}
        date={item.data.date}
        title={item.data.title}
        summary={item.data.summary}
        tags={item.data.tags}
      />
    ))}
  </div>
</ListLayout>
