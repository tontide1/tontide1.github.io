---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { article } from '../../lib/seo';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<ContentLayout
  title={note.data.title}
  command={`cat ~/notes/${note.id}.md`}
  cwd="~/notes"
  description={note.data.summary}
  publishedTime={note.data.date}
  modifiedTime={note.data.updated ?? note.data.date}
  structuredData={article({
    title: note.data.title,
    description: note.data.summary,
    url: Astro.url.href,
    section: 'Notes',
    tags: note.data.tags,
    date: note.data.date,
    updated: note.data.updated,
  })}
>
  <div class="mb-8 flex flex-wrap items-baseline gap-x-4 gap-y-1 text-xs text-muted">
    <span>{note.data.date}</span>
    <span class="text-amber">{note.data.category}</span>
    <span class="flex flex-wrap gap-1.5">
      {note.data.tags.map((tag) => <span class="border border-line px-1.5">#{tag}</span>)}
    </span>
  </div>

  <article>
    <Content />
  </article>

  {note.data.related && note.data.related.length > 0 && (
    <div class="mt-12 border-t border-line pt-6">
      <h3 class="mb-3 mt-0 text-xs uppercase tracking-wide text-muted">related</h3>
      <ul class="m-0 list-none space-y-1 pl-0 text-sm">
        {note.data.related.map((rel) => (
          <li><a href={rel}>{rel}</a></li>
        ))}
      </ul>
    </div>
  )}
</ContentLayout>
