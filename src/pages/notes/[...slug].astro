---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { article } from '../../lib/seo';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<ContentLayout
  domain="NOTES"
  title={note.data.title}
  role="Knowledge Fragment"
  meta={note.data.category}
  description={note.data.summary}
  publishedTime={note.data.date}
  modifiedTime={note.data.updated ?? note.data.date}
  structuredData={article({
    title: note.data.title,
    description: note.data.summary,
    url: Astro.url.href,
    section: 'Notes',
    tags: note.data.tags,
    date: note.data.date,
    updated: note.data.updated,
  })}
>
  <div class="flex items-center space-x-3 text-xs text-[#525252] mb-6">
    <span>RECORDED:</span>
    <span class="text-[#e8e8e8]">{note.data.date}</span>
  </div>

  <article class="space-y-4 text-xs md:text-sm text-[#cccccc] leading-relaxed border-t border-[#1f1f1f] pt-6">
    <Content />
  </article>

  {note.data.related && note.data.related.length > 0 && (
    <div class="mt-12 pt-6 border-t border-[#262626]">
      <h3 class="text-xs font-bold text-[#777777] uppercase tracking-wider mb-3">
        Gravitationally Related Artifacts
      </h3>
      <ul class="space-y-1.5 text-xs">
        {note.data.related.map((rel) => (
          <li>
            <a href={rel} class="text-[#6ea8fe] hover:underline">
              • {rel}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</ContentLayout>
