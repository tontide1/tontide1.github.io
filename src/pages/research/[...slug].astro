---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { article } from '../../lib/seo';

export async function getStaticPaths() {
  const items = await getCollection('research', ({ data }) => !data.draft);
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<ContentLayout
  title={item.data.title}
  command={`cat ~/research/${item.id}.md`}
  cwd="~/research"
  description={item.data.summary}
  publishedTime={item.data.date}
  modifiedTime={item.data.updated ?? item.data.date}
  structuredData={article({
    title: item.data.title,
    description: item.data.summary,
    url: Astro.url.href,
    section: 'Research',
    tags: item.data.tags,
    date: item.data.date,
    updated: item.data.updated,
  })}
>
  <div class="mb-8 flex flex-wrap items-baseline gap-x-4 gap-y-1 text-xs text-muted">
    <span>{item.data.date}</span>
    <span class="text-amber">{item.data.status}</span>
    <span class="flex flex-wrap gap-1.5">
      {item.data.tags.map((tag) => <span class="border border-line px-1.5">#{tag}</span>)}
    </span>
  </div>

  <dl class="mb-10 border border-line p-4 text-sm">
    <dt class="text-xs uppercase tracking-wide text-muted">research question</dt>
    <dd class="mb-4 mt-0">{item.data.research_question}</dd>
    <dt class="text-xs uppercase tracking-wide text-muted">working hypothesis</dt>
    <dd class="m-0 text-muted">{item.data.hypothesis}</dd>
  </dl>

  <article>
    <Content />
  </article>

  {item.data.related && item.data.related.length > 0 && (
    <div class="mt-12 border-t border-line pt-6">
      <h3 class="mb-3 mt-0 text-xs uppercase tracking-wide text-muted">related</h3>
      <ul class="m-0 list-none space-y-1 pl-0 text-sm">
        {item.data.related.map((rel) => (
          <li><a href={rel}>{rel}</a></li>
        ))}
      </ul>
    </div>
  )}
</ContentLayout>
