---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import { collectionPage } from '../lib/seo';

const notes = await getCollection('notes', ({ data }) => !data.draft);

const title = 'Compact Knowledge Fragments';
const description =
  'What Tài learns and records: technical notes, Linux tooling, debugging logs, and concise implementation references.';
---

<ContentLayout
  domain="NOTES"
  title={title}
  role="Compact Asteroid Field"
  type="website"
  meta="DEBUGGING / REFERENCES"
  description={description}
  structuredData={collectionPage({
    title,
    description,
    url: Astro.url.href,
    section: 'Notes',
    items: notes.map((n) => ({ name: n.data.title, url: new URL(`/notes/${n.id}/`, Astro.url).href })),
  })}
>
  <div class="space-y-4">
    {notes.map((note) => (
      <article class="bg-[#0a0a0a] border border-[#1f1f1f] hover:border-[#3a3a3a] transition-colors p-4 rounded">
        <div class="flex items-center justify-between text-[10px] text-[#525252] mb-1.5">
          <span class="text-[#fde68a] font-bold">{note.data.category}</span>
          <span>{note.data.date}</span>
        </div>
        <h2 class="text-sm font-bold text-[#ffffff] mb-1.5">
          <a href={`/notes/${note.id}`} class="hover:text-[#fde68a] transition-colors">
            {note.data.title} →
          </a>
        </h2>
        <p class="text-xs text-[#a3a3a3] leading-relaxed mb-3">
          {note.data.summary}
        </p>
        <div class="pt-2 border-t border-[#1a1a1a] text-xs">
          <a href={`/notes/${note.id}`} class="text-[#fde68a] hover:underline">
            Read Fragment Notes →
          </a>
        </div>
      </article>
    ))}
  </div>
</ContentLayout>
