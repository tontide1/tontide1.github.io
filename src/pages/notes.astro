---
import { getCollection } from 'astro:content';
import ListLayout from '../layouts/ListLayout.astro';
import EntryRow from '../components/site/EntryRow.astro';
import { collectionPage } from '../lib/seo';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);

const title = 'Compact Knowledge Fragments';
const description =
  'What Tài learns and records: technical notes, Linux tooling, debugging logs, and concise implementation references.';
---

<ListLayout
  title={title}
  description={description}
  quote="small things, written down."
  structuredData={collectionPage({
    title,
    description,
    url: Astro.url.href,
    section: 'Notes',
    items: notes.map((n) => ({ name: n.data.title, url: new URL(`/notes/${n.id}/`, Astro.url).href })),
  })}
>
  <div class="entries">
    {notes.map((note) => (
      <EntryRow
        href={`/notes/${note.id}`}
        date={note.data.date}
        meta={note.data.category}
        title={note.data.title}
        summary={note.data.summary}
        tags={note.data.tags}
      />
    ))}
  </div>
</ListLayout>
