---
import { getCollection } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import { collectionPage } from '../lib/seo';

const notes = await getCollection('notes', ({ data }) => !data.draft);

const title = 'Compact Knowledge Fragments';
const description =
  'What Tài learns and records: technical notes, Linux tooling, debugging logs, and concise implementation references.';
---

<ContentLayout
  title={title}
  command="ls"
  cwd="~/notes"
  type="website"
  description={description}
  structuredData={collectionPage({
    title,
    description,
    url: Astro.url.href,
    section: 'Notes',
    items: notes.map((n) => ({ name: n.data.title, url: new URL(`/notes/${n.id}/`, Astro.url).href })),
  })}
>
  <div class="space-y-4">
    {notes.map((note) => (
      <article class="card">
        <div class="card-eyebrow">
          <span class="text-amber">{note.data.category}</span>
          <span>{note.data.date}</span>
        </div>
        <h2 class="mb-1 mt-0 text-base font-bold leading-snug">
          <a href={`/notes/${note.id}`}>{note.data.title}</a>
        </h2>
        <p class="mt-0 text-sm text-muted">{note.data.summary}</p>
        <div class="tags">
          {note.data.tags.map((tag) => <span>#{tag}</span>)}
        </div>
      </article>
    ))}
  </div>
</ContentLayout>
